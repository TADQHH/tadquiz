---
import PublicLayout from '../layouts/PublicLayout.astro';
import SurveyCard from '../components/survey-card/SurveyCard.astro';
import { listForms, getForm } from '../db/forms.mjs';

const published = listForms().filter((f) => f.status === 'published');
const forms = published.flatMap((f) => {
  const detail = getForm(f.id);
  return detail ? [detail] : [];
});
const first = forms[0];
---

<PublicLayout title="TADQuiz" description="Khảo sát của The Anecdotist.">
  <main id="main">
    <section class="tad-grid border-b border-[var(--border)]">
      <div class="page-shell py-16 md:py-24">
        <p class="eyebrow">The Anecdotist — TADQuiz</p>
        <h1 class="section-title max-w-4xl">Khảo sát ngắn. Câu trả lời thật.</h1>
        <p class="lede">
          TADQuiz thu thập ý kiến gọn, rõ, không rườm. Một form, nhiều tiếng nói — giữ mạch chuyện của The Anecdotist.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {first ? (
            <a href={`/q/${first.slug}`} class="btn-primary">
              Vào khảo sát
            </a>
          ) : null}
          <a href="/admin" class="btn-ghost">Quản lý form</a>
        </div>
      </div>
    </section>
    <section class="page-shell py-14">
      <h2 class="section-title">Khảo sát đang mở</h2>
      {forms.length === 0 ? (
        <p class="lede">Chưa có khảo sát nào đang mở.</p>
      ) : (
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {forms.map((form) => (
            <SurveyCard href={`/q/${form.slug}`} title={form.title} count={form.questions.length} />
          ))}
        </div>
      )}
    </section>
  </main>
</PublicLayout>
