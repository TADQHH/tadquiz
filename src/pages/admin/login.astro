---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/login-form/LoginForm.tsx';
---

<BaseLayout title="Đăng nhập — TADQuiz" description="Đăng nhập quản trị TADQuiz." noindex={true}>
  <a class="skip-link" href="#main">Bỏ qua nội dung</a>
  <main id="main" class="grid min-h-[100dvh] md:grid-cols-2">
    <section class="tad-slash hidden min-h-[100dvh] flex-col justify-end p-10 md:flex">
      <p class="font-display text-6xl font-extrabold tracking-tight text-white">TADQUIZ</p>
    </section>
    <section class="flex items-center justify-center p-6 md:p-12">
      <div
        class="w-full max-w-md border-2 border-[var(--tad-black)] bg-[var(--card)] p-8 shadow-[8px_8px_0_var(--tad-red)]"
      >
        <p class="eyebrow">Quản trị</p>
        <h1 class="section-title text-[clamp(1.8rem,4vw,2.6rem)]">Đăng nhập</h1>
        <LoginForm client:load />
      </div>
    </section>
  </main>
</BaseLayout>
