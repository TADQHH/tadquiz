---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import KpiStat from '../../../../components/kpi-stat/KpiStat.astro';
import ResponsesTabs from '../../../../components/responses-view/ResponsesTabs.tsx';
import StatusBadge from '../../../../components/status-badge/StatusBadge.tsx';
import { formatViDate } from '../../../../components/format-date/format-date';
import { getForm } from '../../../../db/forms.mjs';
import { listResponses } from '../../../../db/responses.mjs';

const id = Number.parseInt(String(Astro.params.id ?? ''), 10);
const form = Number.isInteger(id) ? getForm(id) : null;
if (!form) return Astro.redirect('/404');
const rows = listResponses(form.id);
const latest = rows[0]?.submittedAt ? formatViDate(rows[0].submittedAt) : '—';
---

<AdminLayout title={`${form.title} — Phản hồi — TADQuiz`}>
  <main id="main" class="page-shell py-8 md:py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <a
          href={`/admin/f/${form.id}`}
          class="inline-flex min-h-8 items-center gap-1 font-headline text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] hover:text-[var(--tad-red)]"
        >
          ← Quay lại Editor
        </a>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <h1 class="section-title break-words">{form.title}</h1>
          <StatusBadge status={form.status} />
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href={`/api/forms/${form.id}/responses.csv`} class="btn-black text-xs font-bold" download>
          Xuất CSV
        </a>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:mt-8 md:gap-4">
      <KpiStat label="Tổng phản hồi" value={String(rows.length)} />
      <KpiStat label="Câu hỏi" value={String(form.questions.length)} />
      <div class="col-span-2 sm:col-span-1">
        <KpiStat label="Gần nhất" value={latest} />
      </div>
    </div>
    <ResponsesTabs client:load questions={form.questions} rows={rows} />
  </main>
</AdminLayout>
