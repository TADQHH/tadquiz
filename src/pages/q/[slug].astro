---
import PublicLayout from '../../layouts/PublicLayout.astro';
import QuizStepper from '../../components/quiz-stepper/QuizStepper.tsx';
import { getFormBySlug } from '../../db/forms.mjs';

const form = getFormBySlug(Astro.params.slug ?? '');
if (!form || form.status !== 'published') return Astro.redirect('/404');
---

<PublicLayout title={`${form.title} — TADQuiz`} description={form.description || form.title} footer={false}>
  <main id="main">
    <QuizStepper client:load form={form} />
  </main>
</PublicLayout>
