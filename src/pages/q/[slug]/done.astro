---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getFormBySlug } from '../../../db/forms.mjs';

const form = getFormBySlug(Astro.params.slug ?? '');
if (!form) return Astro.redirect('/404');
---

<PublicLayout title={`Đã gửi — ${form.title}`} description="Phản hồi đã được ghi nhận.">
  <main id="main" class="page-shell flex min-h-[70dvh] items-center justify-center py-16">
    <article
      class="w-full max-w-lg border-2 border-[var(--tad-black)] bg-[var(--card)] p-8 text-center shadow-[8px_8px_0_var(--tad-red)]"
    >
      <span
        class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[var(--tad-red)] text-white"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-7 w-7">
          <path fill="currentColor" d="M9.2 16.6 4.8 12.2l-1.4 1.4 5.8 5.8 12-12-1.4-1.4z"></path>
        </svg>
      </span>
      <p class="eyebrow mt-6">Phản hồi đã gửi</p>
      <h1 class="section-title">Cảm ơn bạn</h1>
      <p class="lede mx-auto">Chúng tôi đã nhận phản hồi cho “{form.title}”.</p>
      <a href="/" class="btn-primary mt-8">Về trang chủ</a>
    </article>
  </main>
</PublicLayout>
