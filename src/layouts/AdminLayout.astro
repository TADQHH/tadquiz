---
import BaseLayout from './BaseLayout.astro';
import LogoutButton from '../components/logout-button/LogoutButton.tsx';

type Props = {
  title: string;
  description?: string;
};

const { title, description = 'Quản lý khảo sát TADQuiz.' } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={true}>
  <a class="skip-link" href="#main">Bỏ qua nội dung</a>
  <header
    class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--tad-paper)_92%,transparent)]"
  >
    <div class="page-shell flex items-center justify-between gap-4 py-3">
      <a href="/admin" class="font-display text-xl font-extrabold uppercase tracking-[0.16em]">
        TADQuiz
      </a>
      <nav class="flex items-center gap-2" aria-label="Quản trị">
        <LogoutButton client:load />
      </nav>
    </div>
  </header>
  <slot />
</BaseLayout>
