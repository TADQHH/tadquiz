---
import BaseLayout from './BaseLayout.astro';

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <a class="skip-link" href="#main">Bỏ qua nội dung</a>
  <slot />
</BaseLayout>
