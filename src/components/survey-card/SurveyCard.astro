---
type Props = {
  href: string;
  title: string;
  count: number;
};

const { href, title, count } = Astro.props;
---

<a
  href={href}
  class="brutalist-card block rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-6"
>
  <h3 class="font-headline text-xl font-extrabold">{title}</h3>
  <p class="mt-2 text-sm text-[var(--muted-foreground)]">{count} câu hỏi</p>
  <p class="mt-4 font-headline text-base font-bold uppercase tracking-wide text-[var(--tad-red)]">Bắt đầu</p>
</a>
