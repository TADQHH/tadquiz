---
type Props = {
  label: string;
  value: string;
};

const { label, value } = Astro.props;
---

<article class="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--card)] p-4 sm:p-5 shadow-xs">
  <p class="eyebrow">{label}</p>
  <p class="mt-1.5 font-headline text-xl font-extrabold text-[var(--tad-ink)] sm:text-2xl truncate">{value}</p>
</article>
